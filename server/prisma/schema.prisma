// walkMe server data model.
// SQLite for now — swap `provider` below to "postgresql" and point
// DATABASE_URL at a real database to scale up. No application code
// depends on which database this is.
//
// SQLite has no native enum type, so fields that are conceptually enums
// (provider, status, type, direction) are plain Strings validated by zod
// in the application layer — see src/modules/*/schema.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  provider           String // "google" | "facebook" | "apple" | "dev" | "email"
  providerId         String
  email              String?
  displayName        String
  photoUrl           String?
  bio                String?
  age                Int?
  location           String?
  walkTimes          String? // JSON string[] of preferred walking times (onboarding)
  radiusKm           Float?
  onboardedAt        DateTime?
  lat                Float? // home area, used to compute distances in Discover
  lng                Float?
  status             String    @default("active") // "active" | "suspended" | "banned" — set from the admin panel
  // "person" (default) walks their own dogs like any user; "shelter" manages a roster of adoptable dogs that
  // have no personal owner (see Dog.shelterId) instead of swiping themselves. Set once at signup and not
  // changed afterwards. shelterConfirmedAt records that the "I confirm this is a shelter/rescue" checkbox was
  // checked at signup — an audit trail, not a gate (nothing currently re-checks it after account creation).
  accountType        String    @default("person") // "person" | "shelter"
  shelterConfirmedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  dogs             Dog[]
  shelterDogs      Dog[]                   @relation("ShelterDogs")
  hostedWalks      Walk[]                  @relation("WalkHost")
  walkEntries      WalkParticipant[]
  organizedEvents  Event[]                 @relation("EventOrganizer")
  eventEntries     EventParticipant[]
  eventDogs        EventDog[]
  sentMessages     Message[]
  refreshTokens    RefreshToken[]
  sentDogRequests  DogWalkRequest[]        @relation("DogRequestRequester")
  shelterRequests  DogWalkRequest[]        @relation("DogRequestShelter")
  notifications    Notification[]
  notificationPref NotificationPreference?
  blocksMade       Block[]                 @relation("Blocker")
  blocksReceived   Block[]                 @relation("Blocked")
  reportsMade      Report[]                @relation("Reporter")

  @@unique([provider, providerId])
}

// One row per "send me a code" request. codeHash is sha256(code) — the plain
// 6-digit code only ever exists in memory and in the email itself, never
// stored. A fresh request replaces any earlier unused code for that email
// (see auth/service.ts) so only the most recently sent code is valid.
model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0) // wrong-code guesses; capped in the application layer
  createdAt DateTime @default(now())

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Dog {
  id          String   @id @default(uuid())
  // Exactly one of ownerId/shelterId is set (enforced in the application layer, not here — SQLite has no
  // usable CHECK constraint via Prisma): a person's own dog has ownerId, a shelter's adoptable dog has
  // shelterId instead and no personal owner.
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shelterId   String?
  shelter     User?    @relation("ShelterDogs", fields: [shelterId], references: [id], onDelete: Cascade)
  name        String
  breed       String
  age         Int
  weight      Float?
  bio         String?
  emoji       String?
  energy      String? // Calm | Balanced | High
  ageGroup    String? // Puppy | Adult | Senior
  photoUrl    String?
  personality String // JSON-encoded string[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  walkRequests DogWalkRequest[]
  walkEntries  WalkParticipant[]
  eventEntries EventDog[]
}

model Walk {
  id              String   @id @default(uuid())
  title           String
  description     String?
  category        String   @default("Park")
  hostId          String
  host            User     @relation("WalkHost", fields: [hostId], references: [id], onDelete: Cascade)
  meetingLat      Float
  meetingLng      Float
  meetingPoint    String
  scheduledAt     DateTime
  maxParticipants Int      @default(8)
  status          String   @default("upcoming") // "upcoming" | "live" | "ended"
  duration        String   @default("1h")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participants WalkParticipant[]
  messages     Message[]
}

model WalkParticipant {
  walkId String
  walk   Walk    @relation(fields: [walkId], references: [id], onDelete: Cascade)
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Which dog this participant is bringing — their own, or one they've been approved to walk from a shelter
  // (see DogWalkRequest). Optional: joining a walk never requires naming a dog.
  dogId  String?
  dog    Dog?    @relation(fields: [dogId], references: [id], onDelete: SetNull)

  @@id([walkId, userId])
}

model Event {
  id              String   @id @default(uuid())
  title           String
  description     String?
  date            DateTime
  location        String
  lat             Float
  lng             Float
  organizerId     String
  organizer       User     @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  maxParticipants Int      @default(30)
  status          String   @default("upcoming") // "upcoming" | "live" | "ended"
  category        String   @default("Meetup")
  emoji           String?  @default("🎉")
  photoCaption    String? // describes the event photo (shown in the header stand-in)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participants EventParticipant[]
  dogs         EventDog[]
}

model EventParticipant {
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

// One row per dog a participant is bringing to an event — unlike Walk (one dog per WalkParticipant column),
// an event RSVP can name any number of dogs, so this is its own join table rather than a nullable column.
model EventDog {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dogId   String
  dog     Dog    @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, dogId])
}

model Message {
  id        String   @id @default(uuid())
  roomId    String // walkId or matchId — kept as a plain string room key
  walkId    String?
  walk      Walk?    @relation(fields: [walkId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  type      String   @default("text") // "text" | "image" | "system"
  createdAt DateTime @default(now())
}

model Match {
  id            String   @id @default(uuid())
  userAId       String
  userBId       String
  matchedAt     DateTime @default(now())
  lastMessage   String?
  lastMessageAt DateTime @default(now())
  unreadForA    Int      @default(0)
  unreadForB    Int      @default(0)

  @@unique([userAId, userBId])
}

model Swipe {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  direction  String // "left" | "right"
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
}

// "Liking" a shelter dog in Discover creates one of these instead of a Swipe/Match: it needs shelter approval
// before a conversation opens (unlike a mutual-swipe person match, which is instant), and a shelter can have
// many of these open at once — one per dog per interested person — each its own conversation "on behalf of"
// that dog, which a plain (userA, userB) Match can't represent since a pair can only match once.
model DogWalkRequest {
  id                 String    @id @default(uuid())
  dogId              String
  dog                Dog       @relation(fields: [dogId], references: [id], onDelete: Cascade)
  requesterId        String
  requester          User      @relation("DogRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  // Denormalized from dog.shelterId at creation time: lets the shelter's inbox query by shelterId directly,
  // and survives a shelter dog being reassigned or removed independently of the relation on Dog.
  shelterId          String
  shelter            User      @relation("DogRequestShelter", fields: [shelterId], references: [id], onDelete: Cascade)
  status             String    @default("pending") // "pending" | "accepted" | "declined"
  createdAt          DateTime  @default(now())
  respondedAt        DateTime?
  lastMessage        String?
  lastMessageAt      DateTime  @default(now())
  unreadForRequester Int       @default(0)
  unreadForShelter   Int       @default(0)

  @@unique([dogId, requesterId])
}

// One row per user, created lazily with all-true defaults on first read/write. Six categories cover every
// kind of notification the app can generate — see notifications/service.ts's TYPE_CATEGORY map for which
// event fires which one. "messages" is included for symmetry and mobile's toast suppression even though the
// server doesn't gate persisted Notification rows with it (chat messages already have their own unread state
// and toast, independent of this feed — see GlobalChatNotifier.tsx).
model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches         Boolean  @default(true)
  messages        Boolean  @default(true)
  walks           Boolean  @default(true)
  events          Boolean  @default(true)
  shelterRequests Boolean  @default(true)
  nearby          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// In-app notification feed — the source of truth independent of any device push (this sandbox has no
// APNs/FCM credentials to send a real one; delivery here is the persisted row plus a real-time socket event —
// see notifications/socket.ts). `data` is JSON-encoded { tab, screen, params } telling the client where to
// navigate on tap.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "match" | "walk_joined" | "walk_left" | "walk_nearby" | "event_joined" | "shelter_request" | "shelter_accepted" | "shelter_declined"
  title     String
  body      String
  data      String? // JSON-encoded { tab, screen, params? }
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Place {
  id          String  @id @default(uuid())
  name        String
  category    String
  address     String
  lat         Float
  lng         Float
  rating      Float
  reviewCount Int
  tags        String // JSON-encoded string[]
  isOpen      Boolean @default(true)
  description String?
  emoji       String?
}

// A one-way "I don't want to see or hear from this person" — enforcement (see modules/blocks/service.ts's
// isBlockedPair/blockedUserIds) always checks both directions, so from the product's point of view blocking is
// mutual even though only one side had to act: Discover, matches, dog-request threads and walk listings all
// hide each other from both people, and messaging between them stops either way.
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// A flag for the admin panel's moderation queue — never actioned automatically (unlike Block, which takes
// effect immediately). targetId's meaning depends on targetType and is never a foreign key at the database
// level, the same trade-off Message.roomId already makes, so a report survives even if its target is later
// deleted (the admin view just shows "deleted" instead of failing to load).
model Report {
  id         String    @id @default(uuid())
  reporterId String
  reporter   User      @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // "user" | "dog" | "walk" | "event" | "message"
  targetId   String
  reason     String // short machine key, e.g. "harassment" | "spam" | "fake_profile" | "inappropriate_content" | "safety_concern" | "other"
  details    String?
  status     String    @default("open") // "open" | "reviewed" | "dismissed"
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
}

// ── Admin panel ───────────────────────────────────────────────────────────
// Separate from User: admins sign in with an email + password (the app's
// users never have passwords — social sign-in only), and are never exposed
// through any /api/v1/* route a mobile client calls.

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         String    @default("admin") // "admin" | "superadmin" — only superadmin can manage other admins
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  auditLogs AuditLog[]
}

model AuditLog {
  id         String    @id @default(uuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String // e.g. "user.suspend", "place.delete"
  targetType String // "User" | "Dog" | "Walk" | "Event" | "Place" | "Message" | "Match" | "AdminUser"
  targetId   String
  meta       String? // JSON-encoded details (e.g. { "status": "suspended" })
  createdAt  DateTime  @default(now())
}
