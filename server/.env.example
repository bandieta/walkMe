# Copy to .env and fill in real values before deploying.

NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# SQLite by default. Swap to a postgresql:// URL later to scale up —
# no application code needs to change, just this line + `prisma migrate`.
DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# Dev-only login bypass for testing every other endpoint before real OAuth
# apps exist. NEVER set true in production.
ALLOW_DEV_LOGIN=true

# Admin panel (server/src/modules/admin) — separate secret from the app-user
# tokens above, since admins sign in with a password, not a provider.
JWT_ADMIN_SECRET=change_this_to_a_third_long_random_secret
JWT_ADMIN_EXPIRES_IN=12h

# First admin account, created by `npm run seed:admin` (idempotent — also
# updates the password if the email already exists). Leave unset to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Google Sign-In: the "Web client ID" from Google Cloud Console
# (same one used as `webClientId` in the mobile app's GoogleSignin.configure).
GOOGLE_CLIENT_ID=your_google_web_client_id

# Facebook Login: App ID + App Secret (developers.facebook.com -> Settings -> Basic).
# With both set, the server checks that each token was issued to THIS app
# (a valid token from some other Facebook app is rejected). The secret stays
# on the server only - never put it in the mobile app.
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Apple Sign-In: your app's bundle identifier (must match the `aud` claim
# in the identity token the app sends).
APPLE_BUNDLE_ID=com.walkme

# Local disk storage for uploads (swap for S3/Azure later behind the same
# StorageProvider interface).
UPLOAD_DIR=./uploads
