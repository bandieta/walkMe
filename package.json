{
  "name": "walkme-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "mobile",
    "backend",
    "server",
    "shared"
  ],
  "scripts": {
    "mobile": "yarn workspace @walkme/mobile start",
    "backend": "yarn workspace @walkme/backend start:dev",
    "backend:build": "yarn workspace @walkme/backend build",
    "server": "yarn workspace @walkme/server dev",
    "server:build": "yarn workspace @walkme/server build",
    "server:test": "yarn workspace @walkme/server test",
    "shared:build": "yarn workspace @walkme/shared build",
    "lint": "yarn workspace @walkme/backend lint && yarn workspace @walkme/mobile lint",
    "lint:fix": "yarn workspace @walkme/backend lint --fix && yarn workspace @walkme/mobile lint --fix",
    "test": "yarn workspace @walkme/backend test && yarn workspace @walkme/server test && yarn workspace @walkme/mobile test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "eslint-plugin-prettier": "^5.5.6"
  },
  "lint-staged": {
    "backend/src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "mobile/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "shared/src/**/*.ts": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
